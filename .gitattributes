# Force GitHub to count React TypeScript files heavily
*.tsx linguist-language=TypeScript
*.ts linguist-language=TypeScript

# Hide Laravel system, framework, and vendor files from statistics
vendor/* linguist-vendored
storage/* linguist-vendored
bootstrap/* linguist-vendored
app/Providers/* linguist-vendored
config/* linguist-vendored

# Hide Blade templates if you want React to be dominant
*.blade.php linguist-vendored